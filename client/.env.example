# Copy to .env.local for local development. Vite exposes only VITE_* variables to the browser,
# so never put secrets here.

# Base URL of the ChapterCheck API, no trailing slash.
# Leave empty locally (the Vite dev server proxies /api to http://localhost:5000).
# Production example: https://chaptercheck-api.onrender.com
VITE_API_URL=

# "local"  (default): analyze in the browser; the chapter never leaves the device.
# "server": send the chapter to POST /api/analyze instead.
VITE_ANALYSIS_MODE=local
