# Copy to .env for local development. Never commit .env.
PORT=5000
NODE_ENV=development

# Allowed browser origins, comma-separated, no trailing slash.
# Production example: https://chaptercheck.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Rate limit for POST /api/analyze (per client IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Optional: raw request size cap (default 400kb)
# BODY_LIMIT=400kb

# Optional: number of reverse proxies in front of the app (Render: 1, the default in production)
# TRUST_PROXY=1
